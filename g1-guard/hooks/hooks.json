{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" || true",
            "timeout": 20,
            "statusMessage": "G-1: scanning the prompt"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" || true",
            "timeout": 20,
            "statusMessage": "G-1: scanning what was read"
          }
        ],
        "matcher": "WebFetch|WebSearch|Read|Bash|Glob|Grep|NotebookRead|mcp__.*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" || true",
            "timeout": 20,
            "statusMessage": "G-1: verifying the call"
          }
        ],
        "matcher": "Bash|Write|Edit|NotebookEdit|WebFetch|SendUserFile|mcp__.*"
      }
    ]
  }
}
